# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (strict CORS).
CORS_ORIGINS=http://localhost:4200

# --- Data stores ---
# Transactions require a replica set (single-node replica set is fine for dev).
MONGODB_URI=mongodb://localhost:27017/ereceipt?replicaSet=rs0
# Leave empty to disable the BullMQ worker queue (jobs then run only via admin endpoints).
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# 32-byte key, base64. Encrypts ETA POS credentials and MFA secrets at rest.
DATA_ENCRYPTION_KEY=

# --- ETA integration ---
# preprod | production. Production must never be used for tests.
ETA_ENVIRONMENT=preprod
ETA_IDENTITY_BASE_URL=https://id.preprod.eta.gov.eg
ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
ETA_HTTP_TIMEOUT_MS=30000
# http | simulated. "simulated" is a local test double that never contacts ETA; refused in production.
ETA_TRANSPORT=simulated
# none | external. "none" sends no signature and is refused when ETA_ENVIRONMENT=production.
ETA_SIGNING_MODE=none
# Optional template for receipt QR content. Unverified: leave empty until confirmed from ETA docs.
ETA_RECEIPT_QR_TEMPLATE=

# --- Storage ---
STORAGE_DIR=./storage
